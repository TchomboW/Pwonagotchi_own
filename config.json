{
    "engine": {
        "rust_binary_path": "rust_engine/target/release/pwon_core",
        "subprocess_timeout_seconds": 30,
        "max_crash_retries": 5
    },
    "intelligence": {
        "cycle_interval_seconds": 5,
        "history_file": "intelligence_accumulated.json",
        "seed_targets": [
            "127.0.0.1"
        ]
    },
    "scanners": {
        "ssh": {
            "username": "${PWN_SSH_USER}",
            "password": "${PWN_SSH_PASS}"
        },
        "ftp": {
            "username": "${PWN_FTP_USER}",
            "password": "${PWN_FTP_PASS}"
        },
        "smb": {
            "username": "${PWN_SMB_USER}",
            "password": "${PWN_SMB_PASS}"
        },
        "sql": {
            "username": "${PWN_SQL_USER}",
            "password": "${PWN_SQL_PASS}"
        }
    },
    "logging": {
        "level": "INFO",
        "file": null
    }
}
