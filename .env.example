# Pwonagotchi_own Environment Variables
# Copy this file to .env and fill in your credentials
# .env is in .gitignore and will NOT be committed

PWN_SSH_USER=root
PWN_SSH_PASS=your_secure_ssh_password
PWN_FTP_USER=ftp
PWN_FTP_PASS=your_secure_ftp_password
PWN_SMB_USER=admin
PWN_SMB_PASS=your_secure_smb_password
PWN_SQL_USER=sa
PWN_SQL_PASS=your_secure_sql_password
